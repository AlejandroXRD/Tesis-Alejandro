generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  ADMIN
  DECANO_VICEDECANO
  JEFE_DEPARTAMENTO
  PPA
  PROFESOR
  NUEVO_USUARIO
}

enum Periodo {
  PRIMERO
  SEGUNDO
}

enum Modalidad {
  DIURNO
  ENCUENTRO
}

enum estadoTarea {
  PENDIENTE
  EN_REVISION
  COMPLETADA
  RECHAZADA  // ← AGREGUÉ RECHAZADA (en tu código estaba CANCELADA)
}

model User {
  userId    String   @id @default(uuid())
  userName  String   @unique
  password  String
  rol       Rol      @default(NUEVO_USUARIO)
  apellido  String
  createdAt DateTime @default(now())

  colectivos ColectivoProfesor[]
  tareas     Tarea[]
}

model Colectivo {
  colectivoId     String   @id @default(uuid())
  nombreColectivo String
  year            Int
  modalidad       Modalidad
  periodo         Periodo
  createdAt       DateTime @default(now())

  profesores ColectivoProfesor[]
}

model Tarea {
  tareaId     String      @id @default(uuid())
  nombreTarea String
  descripcion String
  fechaLimite DateTime
  estado      estadoTarea @default(PENDIENTE)
  archivo     String?
  comentario  String?     // ← solo esta línea
  revisorNombre String? 
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  profesor User   @relation(fields: [userId], references: [userId])
  userId   String
}

model ColectivoProfesor {
  colectivo   Colectivo @relation(fields: [colectivoId], references: [colectivoId])
  colectivoId String

  profesor   User   @relation(fields: [userId], references: [userId])
  userId     String

  asignatura String
  createdAt  DateTime @default(now())

  @@id([colectivoId, userId])
}
