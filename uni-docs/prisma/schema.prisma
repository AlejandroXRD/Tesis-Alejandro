generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  ADMIN
  DECANO_VICEDECANO
  JEFE_DEPARTAMENTO
  PPA
  PROFESOR
  NUEVO_USUARIO
}

enum Modalidad {
  DIURNO
  ENCUENTRO
}

enum estadoTarea {
  PENDIENTE
  EN_REVISION   // ÔåÉ verifica la mayúscula/minúscula
  COMPLETADA
  CANCELADA
}


model User {
  userId    String   @id @default(uuid())
  userName  String   @unique
  password  String
  rol       Rol      @default(PROFESOR)
  apellido  String
  createdAt DateTime @default(now())

  colectivos ColectivoProfesor[]
  tareas     Tarea[]
}

model Colectivo {
  colectivoId     String   @id @default(uuid())
  nombreColectivo String
  year            Int
  modalidad       Modalidad
  createdAt       DateTime @default(now())

  profesores ColectivoProfesor[]
}

model Tarea {
  tareaId     String      @id @default(uuid())
  nombreTarea String
  descripcion String
  fechaLimite DateTime
  estado      estadoTarea @default(PENDIENTE)

  profesor User   @relation(fields: [userId], references: [userId])
  userId   String
}

model ColectivoProfesor {
  colectivo   Colectivo @relation(fields: [colectivoId], references: [colectivoId])
  colectivoId String

  profesor   User   @relation(fields: [userId], references: [userId])
  userId     String

  asignatura String
  createdAt  DateTime @default(now())

  @@id([colectivoId, userId])
}

