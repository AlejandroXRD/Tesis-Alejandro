// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  userId String @id @default(uuid())
  userName String
  password String?
  rol Rol
  apellido String
  createdAt DateTime @default(now())

  colectivos ColectivoProfesor[]
  tareas Tarea[]
}
model Colectivo {
  colectivoId String @id @default(uuid())
  nombreColectivo String
  year Int
  modalidad Modalidad
  createdAt DateTime @default(now())

  profesores ColectivoProfesor[]
}

model Tarea {
  tareaId String @id @default(uuid())
  nombreTarea String
  descripcion String
  fechaLimite DateTime
  estado estadoTarea

  profesor User @relation(fields: [userId], references: [userId])
  userId String
}

model ColectivoProfesor {
  colectivo   Colectivo @relation(fields: [colectivoId], references: [colectivoId])
  colectivoId String

  profesor   User @relation(fields: [userId], references: [userId])
  userId String

  asignatura String
  createdAt DateTime @default(now())

  @@id([colectivoId, userId])
}
enum Rol {
  ADMIN
  PPA
  JEFE_COLECTIVO
  PROFESOR
}
enum Modalidad {
  DIURNO
  ENCUENTRO
}
enum estadoTarea {
  COMPLETADA
  RECHAZADA
  EN_REVIsION
  PENDIENTE
}